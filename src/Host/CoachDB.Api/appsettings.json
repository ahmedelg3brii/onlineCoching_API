{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Jwt": {
    "Issuer": "https://api.coachdb.app",
    "Audience": "coachdb",
    "SigningKey": ""
  },
  "Tenancy": {
    "RootDomain": ""
  },
  "Tenants": {
    "TrialDays": 14,
    "TrialPlanCode": "starter",
    "MaxOwnedTenantsPerUser": 3
  },
  "Cors": {
    "Origins": []
  },
  "AllowedHosts": "*"
}
